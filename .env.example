# Where the React app finds the PHP API during local development.
# Render's production URL is configured in the repository-root render.yaml.
VITE_API_BASE_URL=/api

# Dev proxy only: where XAMPP serves the project.
# C:\xampp\htdocs\thinktogether  ->  http://localhost/thinktogether/api
VITE_DEV_PROXY_TARGET=http://localhost
VITE_DEV_API_PATH=/thinktogether/api

# For a manual Render setup, use VITE_API_BASE_URL=https://tt.zenirox.com
# and add the exact Render site origin to ALLOWED_ORIGINS in the Hostinger api/.env.
